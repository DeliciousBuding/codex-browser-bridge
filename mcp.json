{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-browser": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@delicious233/codex-browser-bridge@3.0.0",
        "--surface",
        "native-browser",
        "--mode",
        "mcp"
      ]
    },
    "codex-computer": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@delicious233/codex-browser-bridge@3.0.0",
        "--surface",
        "computer",
        "--mode",
        "mcp"
      ]
    }
  }
}
