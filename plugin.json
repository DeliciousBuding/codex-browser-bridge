{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-browser",
  "version": "1.11.2",
  "description": "Control an existing logged-in Chromium browser through the ChatGPT desktop app's browser extension.",
  "author": {
    "name": "DeliciousBuding",
    "url": "https://github.com/DeliciousBuding"
  },
  "homepage": "https://github.com/DeliciousBuding/codex-browser-bridge",
  "repository": "https://github.com/DeliciousBuding/codex-browser-bridge",
  "license": "MIT",
  "keywords": ["browser", "mcp", "chromium", "automation", "chatgpt"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex Browser",
        "shortDescription": "Control your logged-in browser",
        "longDescription": "Use the ChatGPT desktop app's browser extension to inspect and operate existing Chromium tabs without copying cookies or a browser profile.",
        "developerName": "DeliciousBuding",
        "category": "Developer Tools",
        "capabilities": [
          "Reuse existing browser sessions",
          "Automate tabs and navigation",
          "Inspect DOM, screenshots, and network activity"
        ]
      }
    }
  }
}
